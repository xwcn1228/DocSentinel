{
  "name": "docsentinel",
  "productName": "DocSentinel",
  "version": "1.3.0",
  "description": "DocSentinel（文档哨兵）：长文档 AI 风格双路循环审查与自动修改。Dual-lane AI-style risk review and auto-revision for long documents.",
  "main": "./out/main/main.js",
  "scripts": {
    "predev": "node scripts/check-node.cjs",
    "dev": "electron-vite dev --watch",
    "prebuild": "node scripts/check-node.cjs",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "release-major": "standard-version --release-as major",
    "release-minor": "standard-version --release-as minor",
    "release-patch": "standard-version --release-as patch",
    "lint:fix": "eslint --ext .js,.ts,.vue . --fix",
    "pretest": "node scripts/check-node.cjs",
    "test": "vitest run",
    "test:dual-review": "vitest run __tests__/dualReview.test.ts __tests__/dualReviewIpc.test.ts __tests__/dualReviewDocx.test.ts",
    "test:word-process": "node scripts/check-node.cjs && tsc src/main/wordProcess.ts --target es2020 --module commonjs --esModuleInterop --skipLibCheck --moduleResolution node --outDir __tests__/tmp_compile && node __tests__/wordProcess.test.js",
    "commit": "git add . && git-cz"
  },
  "engines": {
    "node": ">=24"
  },
  "eslintConfig": {
    "extends": "./.eslintrc.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@electron/fuses": "^1.8.0",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "30.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.25.0",
    "eslint-plugin-vue": "^9.25.0",
    "git-cz": "^4.9.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "standard-version": "^9.5.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.6.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.0.12",
    "vitest": "^1.6.0"
  },
  "keywords": [],
  "author": {
    "name": "CZ600",
    "url": "https://github.com/CZ600"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@google/genai": "^1.17.0",
    "@google/generative-ai": "^0.24.1",
    "@vueuse/core": "^14.0.0",
    "axios": "^1.11.0",
    "docx-edit": "^0.3.2",
    "element-plus": "^2.11.1",
    "jszip": "^3.10.1",
    "openai": "^5.19.1",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "vue": "^3.4.27",
    "vue-i18n": "^11.3.0",
    "vue-router": "^4.5.1"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "npm run lint:fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "git-cz"
    }
  }
}
